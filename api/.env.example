DATABASE_URL="mysql://user:password@localhost:3306/wedify"

JWT_ACCESS_SECRET="change-me"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-too"
JWT_REFRESH_EXPIRES_IN="7d"

PORT=4000
CORS_ORIGIN="http://localhost:3000"
ADMIN_CORS_ORIGIN="http://localhost:3001"
PUBLIC_API_URL="http://localhost:4000/api/v1"
STORAGE_ROOT="./storage"

# Tim ao (hearts): khach nap tien mua tim -> tang qua -> host doi tim ra tien
HEART_BUY_VND=1000
HEART_CASHOUT_VND=700
# Webhook POST /webhooks/payments/heart-topup ky HMAC-SHA256 bang secret nay (bat buoc khi dung cong thanh toan that)
PAYMENT_WEBHOOK_SECRET=
# Tai khoan nhan tien nap (hien QR VietQR cho khach)
PLATFORM_BANK_NAME=
PLATFORM_BANK_ACCOUNT=
PLATFORM_BANK_HOLDER=
# Che do thu nghiem: cho phep tu xac nhan don nap (mac dinh bat khi NODE_ENV != production)
PAYMENT_SANDBOX=true
