// Prisma schema - Wedify (nen tang DB cho toan bo SRS: Auth, Invitation, Guest, RSVP,
// Wish, Gift, Wallet, Subscription, Affiliate). MySQL 8+ (ho tro JSON column + Enum).
//
// Chay sau khi cau hinh DATABASE_URL trong .env:
//   npx prisma generate
//   npx prisma migrate dev --name init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// AUTH & ACCOUNT (muc 3.1)
// =============================================================================

enum UserRole {
  HOST // Co dau/chu re - vai tro mac dinh khi dang ky
  ADMIN // Van hanh he thong - vao duoc Admin Panel
}

enum PlanTier {
  FREE
  BASIC
  PREMIUM
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum CollaboratorRole {
  OWNER
  EDITOR
}

enum InvitationStatus {
  DRAFT
  PUBLISHED
  EXPIRED
}

enum GuestGroup {
  FAMILY
  FRIEND
  COLLEAGUE
  OTHER
}

enum RsvpStatus {
  PENDING
  ATTENDING
  NOT_ATTENDING
}

enum GiftType {
  BANK_QR
  VIRTUAL_GIFT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
}

// User = Host/Admin (Guest KHONG co tai khoan - dinh danh rieng qua Guest.personalizedToken)
model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String? // null neu chi dang nhap qua OAuth (Google/Facebook)
  emailVerified DateTime?
  name          String?
  phone         String?
  avatarUrl     String?
  role          UserRole  @default(HOST)
  isLocked      Boolean   @default(false) // Admin khoa tai khoan (muc 3.15) - tai khoan bi khoa khong dang nhap duoc

  // Goi dich vu hien tai (mo rong: lich su nam trong bang Subscription)
  planId        String?
  plan          Plan?     @relation(fields: [planId], references: [id])
  planExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // OAuth (NextAuth/Auth.js adapter - Google/Facebook)
  accounts OAuthAccount[]
  sessions Session[]

  invitations   Invitation[]             @relation("InvitationOwner")
  collaborates  InvitationCollaborator[]
  wallet        Wallet?
  heartTopups   HeartTopup[]
  subscriptions Subscription[]
  affiliate     AffiliatePartner?

  @@map("users")
}

// Bang chuan cua NextAuth Prisma Adapter - luu lien ket tai khoan Google/Facebook
model OAuthAccount {
  id                String  @id @default(uuid())
  userId            String
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider          String // "google" | "facebook"
  providerAccountId String
  accessToken       String? @db.Text
  refreshToken      String? @db.Text
  expiresAt         Int?

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime

  @@map("sessions")
}

// Token dung 1 lan cho "quen mat khau" / xac thuc email
model VerificationToken {
  id         String   @id @default(uuid())
  identifier String // email
  token      String   @unique
  type       String // "password_reset" | "email_verify"
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// =============================================================================
// PLAN & SUBSCRIPTION (muc 3.12) - KHONG hardcode gioi han, doc tu bang nay
// =============================================================================

model Plan {
  id                    String   @id @default(uuid())
  tier                  PlanTier @unique
  name                  String
  price                 Int // VND, 0 = Free
  maxImages             Int
  maxViews              Int
  maxInvitations        Int
  storageDurationMonths Int
  templateTierAccess    PlanTier // cap template toi da duoc dung (FREE < BASIC < PREMIUM)
  hasWatermarkRemoval   Boolean  @default(false)
  hasCustomMusic        Boolean  @default(false)
  hasCustomFont         Boolean  @default(false)
  hasZenAi              Boolean  @default(false)

  users         User[]
  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id            String        @id @default(uuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  planId        String
  plan          Plan          @relation(fields: [planId], references: [id])
  startedAt     DateTime      @default(now())
  expiresAt     DateTime
  paymentStatus PaymentStatus @default(PENDING)
  amountPaid    Int
  createdAt     DateTime      @default(now())

  @@map("subscriptions")
}

// =============================================================================
// TEMPLATE SYSTEM (muc 3.4)
// =============================================================================

model Template {
  id           String           @id @default(uuid())
  name         String
  categoryId   String
  category     TemplateCategory @relation(fields: [categoryId], references: [id])
  styleId      String?
  style        TemplateStyle?   @relation(fields: [styleId], references: [id])
  tier         PlanTier         @default(FREE)
  thumbnailUrl String
  // Snapshot canvasSettings + elements[] (dung chung shape voi types/editor.ts hien co)
  contentJson  Json
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  invitations Invitation[]

  @@index([categoryId])
  @@index([styleId])
  @@map("templates")
}

model TemplateCategory {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]

  @@map("template_categories")
}

model TemplateStyle {
  id          String     @id @default(uuid())
  name        String     @unique
  slug        String     @unique
  description String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  templates   Template[]

  @@map("template_styles")
}

model Component {
  id           String   @id @default(uuid())
  name         String
  type         String
  category     String
  description  String?
  tier         PlanTier @default(FREE)
  thumbnailUrl String?
  configJson   Json     @default("{}")
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tier])
  @@index([category])
  @@map("components")
}

// =============================================================================
// INVITATION - CORE ENTITY (muc 3.2, 3.5)
// =============================================================================

model Invitation {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("InvitationOwner", fields: [userId], references: [id])
  templateId  String?
  template    Template?        @relation(fields: [templateId], references: [id])
  slug        String           @unique // link cong khai: /thiep/{slug}
  title       String
  eventDate   DateTime?
  location    String?
  profileJson Json             @default("{}")
  // Toan bo noi dung thiet ke: { canvasSettings, elements[] } - xem types/editor.ts
  // CanvasSettings/EditorElement hien co cua editor, TAI SU DUNG khong doi kieu du lieu.
  contentJson Json
  status      InvitationStatus @default(DRAFT)
  viewCount   Int              @default(0)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  expiresAt   DateTime? // tinh tu storageDurationMonths cua Plan luc publish

  collaborators InvitationCollaborator[]
  guests        Guest[]
  wishes        Wish[]
  gifts         Gift[]

  @@index([userId])
  @@map("invitations")
}

// Chia se quyen quan ly 1 thiep (muc 3.11)
model InvitationCollaborator {
  id           String           @id @default(uuid())
  invitationId String
  invitation   Invitation       @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         CollaboratorRole @default(EDITOR)
  invitedAt    DateTime         @default(now())

  @@unique([invitationId, userId])
  @@map("invitation_collaborators")
}

// =============================================================================
// GUEST & RSVP - differentiator chinh (muc 3.3, 3.6, 3.7)
// =============================================================================

model Guest {
  id                String     @id @default(uuid())
  invitationId      String
  invitation        Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  name              String
  honorific         String? // cach xung ho: "anh", "chi", "co", "bac"...
  phone             String?
  email             String?
  group             GuestGroup @default(OTHER)
  note              String?    @db.Text
  // Token kho doan (UUID) - dung lam /thiep/{slug}?g={personalizedToken} hoac /t/{personalizedToken}
  // KHONG duoc de guest nay doan ra token cua guest khac (yeu cau bao mat 4.2).
  personalizedToken String     @unique @default(uuid())
  sentAt            DateTime?
  viewedAt          DateTime?
  createdAt         DateTime   @default(now())

  rsvp   Rsvp?
  wishes Wish[]
  gifts  Gift[]

  @@index([invitationId])
  @@map("guests")
}

model Rsvp {
  id                 String     @id @default(uuid())
  guestId            String     @unique
  guest              Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  status             RsvpStatus @default(PENDING)
  numberOfCompanions Int        @default(0)
  note               String?    @db.Text
  respondedAt        DateTime?

  @@map("rsvp")
}

// =============================================================================
// GUESTBOOK (muc 3.8)
// =============================================================================

model Wish {
  id           String     @id @default(uuid())
  invitationId String
  invitation   Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestId      String?
  guest        Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  guestName    String // luu lai ten hien thi luc gui, phong khi Guest bi xoa
  message      String     @db.Text
  giftCode     String? // co gia tri khi loi chuc di kem qua tang (GiftItem.code)
  isHidden     Boolean    @default(false) // Admin/Host an loi chuc phan cam
  createdAt    DateTime   @default(now())

  @@index([invitationId])
  @@map("wishes")
}

// =============================================================================
// GIFT / WALLET / WITHDRAWAL (muc 3.10) - tach rieng, rui ro compliance cao nhat
// =============================================================================

model Gift {
  id            String     @id @default(uuid())
  invitationId  String
  invitation    Invitation @relation(fields: [invitationId], references: [id], onDelete: Cascade)
  guestId       String?
  guest         Guest?     @relation(fields: [guestId], references: [id], onDelete: SetNull)
  type          GiftType
  amount        Int // VND (quy doi neu la virtual_gift)
  animationType String? // kieu hieu ung hien thi tren thiep khi type = virtual_gift
  // Qua tang bang TIM (virtual_gift): nguoi gui tra `hearts` tim, host nhan lai `hearts` tim nhan duoc
  giftItemId    String?
  giftItem      GiftItem?  @relation(fields: [giftItemId], references: [id], onDelete: SetNull)
  hearts        Int        @default(0)
  senderUserId  String?
  senderName    String?
  message       String?    @db.Text
  createdAt     DateTime   @default(now())

  @@index([invitationId])
  @@index([senderUserId])
  @@map("gifts")
}

model Wallet {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  balance        Int      @default(0) // VND da quy doi, co the rut
  heartBalance   Int      @default(0) // tim DA MUA (nap tien), dung de tang qua - KHONG doi ra tien
  receivedHearts Int      @default(0) // tim NHAN DUOC tu qua tang, doi ra VND vao `balance`
  updatedAt      DateTime @updatedAt

  withdrawals Withdrawal[]

  @@map("wallets")
}

model Withdrawal {
  id          String           @id @default(uuid())
  walletId    String
  wallet      Wallet           @relation(fields: [walletId], references: [id])
  amount      Int
  status      WithdrawalStatus @default(PENDING)
  bankInfo    Json // { bankName, accountNumber, accountHolder }
  requestedAt DateTime         @default(now())
  processedAt DateTime?

  @@map("withdrawals")
}

// =============================================================================
// AFFILIATE (muc 3.13)
// =============================================================================

model AffiliatePartner {
  id             String          @id @default(uuid())
  userId         String          @unique
  user           User            @relation(fields: [userId], references: [id])
  referralCode   String          @unique
  commissionRate Float // vd 0.1 = 10%
  status         AffiliateStatus @default(PENDING) // Admin duyet doi tac (muc 3.15)
  createdAt      DateTime        @default(now())

  conversions AffiliateConversion[]

  @@map("affiliate_partners")
}

model AffiliateConversion {
  id               String           @id @default(uuid())
  affiliateId      String
  affiliate        AffiliatePartner @relation(fields: [affiliateId], references: [id])
  referredUserId   String // id cua User moi duoc gioi thieu (khong rang buoc FK cung de tranh xoa loi)
  commissionAmount Int
  convertedAt      DateTime         @default(now())

  @@map("affiliate_conversions")
}

// =============================================================================
// HEARTS - tien te ao: khach nap tien mua tim -> dung tim tang qua -> host doi tim ra tien
// =============================================================================

enum HeartTopupStatus {
  PENDING
  PAID
  CANCELLED
}

enum HeartTransactionKind {
  TOPUP // +heartBalance (nap tien mua tim)
  GIFT_SENT // -heartBalance (tang qua)
  GIFT_RECEIVED // +receivedHearts (host nhan qua)
  EXCHANGE // -receivedHearts, +balance VND (host doi tim ra tien)
}

model GiftItem {
  id            String   @id @default(uuid())
  code          String   @unique
  name          String
  emoji         String
  heartPrice    Int
  animationType String?
  sortOrder     Int      @default(0)
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())

  gifts Gift[]

  @@map("gift_items")
}

model HeartTopup {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  hearts      Int
  amountVnd   Int
  paymentCode String           @unique // noi dung chuyen khoan / ma doi soat voi cong thanh toan
  status      HeartTopupStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  paidAt      DateTime?

  @@index([userId])
  @@map("heart_topups")
}

model HeartTransaction {
  id        String               @id @default(uuid())
  userId    String
  kind      HeartTransactionKind
  hearts    Int // luon duong; chieu tang/giam suy ra tu `kind`
  vndAmount Int                  @default(0)
  refId     String? // topup / gift / ... lien quan
  createdAt DateTime             @default(now())

  @@index([userId, createdAt])
  @@map("heart_transactions")
}
